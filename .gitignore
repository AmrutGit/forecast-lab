# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg

# --- Data & model artifacts (regenerate via scripts, don't commit) ---
data/raw/*.csv
data/processed/*.parquet
data/processed/*.joblib
models/*.joblib
models/*.txt
models/registry.json
ml/mlruns/
ml/mlartifacts/
docs/eda/*.png
docs/eda/*.json
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!docs/eda/.gitkeep

# --- Logs ---
*.log
logs/

# --- Env files ---
.env
.env.*
!.env.example

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
npm-debug.log*

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp
